{
  "name": "NiimBlue",
  "short_name": "niimblue",
  "description": "NIIMBOT custom web client/app. Design and print labels with NIIMBOT printers directly from your PC or mobile web browser!",
  "icons": [
    {
      "src": "favicon.svg",
      "sizes": "any"
    },
    {
      "src": "favicon-512.png",
      "sizes": "512x512"
    }
  ],
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#212529",
  "background_color": "#212529",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
